rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role in ['ADMIN', 'SUPERADMIN']) ||
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          'role' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPERADMIN']
        )
      );
    }

    function isApprovedCompanyOrAdmin() {
      return isAdmin() || (
        isAuthenticated() &&
        (
          ('role' in request.auth.token && request.auth.token.role in ['COMPANY', 'company']) ||
          (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
            'role' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['COMPANY', 'company']
          )
        ) &&
        firestore.exists(/databases/(default)/documents/companies/$(request.auth.uid)) &&
        (
          ('verificationStatus' in firestore.get(/databases/(default)/documents/companies/$(request.auth.uid)).data &&
           firestore.get(/databases/(default)/documents/companies/$(request.auth.uid)).data.verificationStatus == 'APPROVED') ||
          ('status' in firestore.get(/databases/(default)/documents/companies/$(request.auth.uid)).data &&
           firestore.get(/databases/(default)/documents/companies/$(request.auth.uid)).data.status == 'APPROVED')
        )
      );
    }

    // Raster images only — excludes image/svg+xml to prevent stored XSS
    function isSafeRasterImage() {
      return request.resource != null &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    // Standard CV / document MIME types
    function isSafeDocument() {
      return request.resource != null &&
        request.resource.contentType != null &&
        request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'text/plain'
        ];
    }

    // Safe take-home challenge submission types (allows safe docs, archives, raster images,
    // and application/octet-stream ONLY when filename has an approved non-executable extension)
    function isSafeSubmission(fileName) {
      return request.resource != null &&
        request.resource.contentType != null &&
        fileName.matches('.*\\.(pdf|PDF|zip|ZIP|docx|DOCX|doc|DOC|png|PNG|jpg|JPG|jpeg|JPEG|txt|TXT)$') &&
        !request.resource.contentType.matches('.*(html|svg|javascript|ecmascript|x-msdownload|x-executable|x-sh).*') &&
        (
          request.resource.contentType in [
            'application/pdf',
            'application/zip',
            'application/x-zip-compressed',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'text/plain',
            'image/png',
            'image/jpeg',
            'image/jpg',
            'application/octet-stream'
          ]
        );
    }

    // Candidate profile pictures (users/ path)
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && isSafeRasterImage()
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Candidate profile pictures (profile_photos/ path)
    match /profile_photos/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && isSafeRasterImage()
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Community post images
    match /community_posts/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && isSafeRasterImage()
        && request.resource.size <= 15 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Candidate CVs / Resumes (owner + verified company/admin only)
    match /users/{userId}/cv/{fileName} {
      allow read: if isOwner(userId) || isApprovedCompanyOrAdmin();
      allow create, update: if isOwner(userId)
        && isSafeDocument()
        && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Candidate Certifications (owner + verified company/admin only)
    match /users/{userId}/certificates/{fileName} {
      allow read: if isOwner(userId) || isApprovedCompanyOrAdmin();
      allow create, update: if isOwner(userId)
        && (isSafeDocument() || isSafeRasterImage())
        && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Company logos & brand assets (authenticated owner path: companies/{companyId}/logo/{fileName})
    match /companies/{companyId}/logo/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(companyId)
        && isSafeRasterImage()
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(companyId);
    }

    // Take-home challenge assignment submissions
    // Enforces owner-prefixed filename + customMetadata.candidateId and restricts reads to owner, challenge company, or admin
    match /assignment_submissions/{challengeId}/{fileName} {
      allow read: if isAuthenticated() && (
        fileName.matches('^' + request.auth.uid + '_.*') ||
        (
          firestore.exists(/databases/(default)/documents/challenges/$(challengeId)) &&
          'companyId' in firestore.get(/databases/(default)/documents/challenges/$(challengeId)).data &&
          firestore.get(/databases/(default)/documents/challenges/$(challengeId)).data.companyId == request.auth.uid
        ) ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && fileName.matches('^' + request.auth.uid + '_.*')
        && request.resource.metadata != null
        && 'candidateId' in request.resource.metadata
        && request.resource.metadata.candidateId == request.auth.uid
        && isSafeSubmission(fileName)
        && request.resource.size <= 20 * 1024 * 1024;
      allow update: if isAuthenticated()
        && fileName.matches('^' + request.auth.uid + '_.*')
        && resource != null
        && resource.metadata != null
        && 'candidateId' in resource.metadata
        && resource.metadata.candidateId == request.auth.uid
        && request.resource.metadata != null
        && 'candidateId' in request.resource.metadata
        && request.resource.metadata.candidateId == request.auth.uid
        && isSafeSubmission(fileName)
        && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if isAuthenticated()
        && fileName.matches('^' + request.auth.uid + '_.*')
        && resource != null
        && resource.metadata != null
        && 'candidateId' in resource.metadata
        && resource.metadata.candidateId == request.auth.uid;
    }
  }
}
